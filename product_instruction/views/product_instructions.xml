<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_instructions_form" model="ir.ui.view">
            <field name="name">product.instructions.form</field>
            <field name='model'>product.instructions</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="product_instructions"/>
                            <field name="product_tmpl_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="product_instructions_list_opportunity" model="ir.ui.view">
            <field name="name">product.instructions.list.opportunity</field>
            <field name="model">product.instructions</field>
            <!-- <field name="inherit_id" ref="crm.crm_case_list_view_oppor"></field> -->
            <field name="arch" type="xml">
                <list>
                    <field name="product_instructions"/>
                    <field name="product_tmpl_id" />
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="product_instructions_action_window">
            <field name="name">Custom Addons</field>
            <field name="res_model">product.instructions</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="product_instructions_list" model="ir.ui.view">
            <field name="name">product.instructions.list</field>
            <field name="model">product.instructions</field>
            <field name="arch" type="xml">
                <list string="Custom Addons" multi_edit="1">
                    <field name="product_instructions" readonly="1"/>
                    <field name="product_tmpl_id" readonly="1"/>
                </list>
            </field>
        </record>
        <menuitem id="menu_product_instructions" name="Add Custom Addons" parent='website_sale.menu_ecommerce_settings' sequence="160" action="product_instructions_action_window"/>
    </data>
</odoo>